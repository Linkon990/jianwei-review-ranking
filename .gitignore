# Public repository uses an explicit file list. Everything else stays local.
/*
!/.gitignore
!/.gitattributes
!/.node-version
!/LICENSE
!/README.md
!/package.json
!/run_demo.ps1
!/src/
!/web/
!/scripts/
!/docs/

/src/*
!/src/comment_ranker.py
!/src/demo_server.py
!/src/sample_data.py
!/src/evaluation.py

/web/*
!/web/index.html
!/web/style.css
!/web/app.js
!/web/demo-engine.js
!/web/sample-data.js
!/web/favicon.svg
!/web/_headers

/scripts/*
!/scripts/build_pages.mjs
!/scripts/export_sample_data.py

/docs/*
!/docs/algorithm.md
!/docs/deployment.md
!/docs/assets/
/docs/assets/*
!/docs/assets/preview.png
